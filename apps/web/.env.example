# The hosted room demo. Locally, copy to .env.local (ignored); on Vercel, set these as environment variables.

# Turso, where each visitor's run, the live spend and new recordings are kept. Leave unset locally to use data/web.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Live ticks: the key for Managed Agents, and the password that unlocks live ticks in a browser. With either unset,
# the page runs replays and the stand-in only.
ANTHROPIC_API_KEY=
LIVE_PASSWORD=
# Optional: signs the unlock cookie. Defaults to the password; set it to lock every browser without changing that.
LIVE_COOKIE_SECRET=
